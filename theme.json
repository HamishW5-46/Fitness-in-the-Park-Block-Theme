{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1180px"
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#fffafd"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#ffffff"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#2b2230"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#665a69"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#c41a8a"
				},
				{
					"slug": "moss",
					"name": "Deep Plum",
					"color": "#3a1230"
				},
				{
					"slug": "sage",
					"name": "Leaf Tint",
					"color": "#eff7ea"
				},
				{
					"slug": "sky",
					"name": "Blush",
					"color": "#fbf0f7"
				},
				{
					"slug": "clay",
					"name": "Soft Neutral",
					"color": "#f5f1f4"
				},
				{
					"slug": "leaf",
					"name": "Leaf Green",
					"color": "#6cb83f"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"name": "2X Small",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "X Small",
					"size": "0.875rem"
				},
				{
					"slug": "40",
					"name": "Small",
					"size": "1.25rem"
				},
				{
					"slug": "50",
					"name": "Medium",
					"size": "clamp(1.75rem, 4vw, 3rem)"
				},
				{
					"slug": "60",
					"name": "Large",
					"size": "clamp(2.5rem, 6vw, 5rem)"
				},
				{
					"slug": "70",
					"name": "X Large",
					"size": "clamp(4rem, 9vw, 8rem)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "Montserrat, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/montserrat-v31-latin-regular.woff2"
							]
						},
						{
							"fontFamily": "Montserrat",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/montserrat-v31-latin-italic.woff2"
							]
						},
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/montserrat-v31-latin-500.woff2"
							]
						},
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/montserrat-v31-latin-600.woff2"
							]
						},
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/montserrat-v31-latin-700.woff2"
							]
						},
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "800",
							"src": [
								"file:./assets/fonts/montserrat-v31-latin-800.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.05rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "clamp(1.25rem, 2vw, 1.55rem)"
				},
				{
					"slug": "x-large",
					"name": "X Large",
					"size": "clamp(2.1rem, 5vw, 4.75rem)"
				}
			]
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|40",
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.65"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "999px"
				},
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|surface"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"right": "1.25rem",
						"bottom": "0.85rem",
						"left": "1.25rem"
					}
				},
				"typography": {
					"fontSize": "0.95rem",
					"fontWeight": "750"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "800",
					"letterSpacing": "0",
					"lineHeight": "0.98"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "clamp(1.75rem, 3vw, 3rem)",
					"fontWeight": "800",
					"letterSpacing": "0",
					"lineHeight": "1.05"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "clamp(1.18rem, 1.7vw, 1.5rem)",
					"fontWeight": "780",
					"letterSpacing": "0",
					"lineHeight": "1.18"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|moss"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "0.92rem",
					"fontWeight": "650"
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "800",
					"lineHeight": "1.05"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|accent",
						"style": "solid",
						"width": "4px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|40"
					}
				}
			}
		}
	}
}
